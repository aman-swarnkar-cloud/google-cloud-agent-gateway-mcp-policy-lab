[
  {
    "description": "Allow MCP discovery and handshake",
    "effect": "ALLOW",
    "principals": [
      "${AGENT_PRINCIPAL}"
    ],
    "operation": {
      "permissions": [
        "iap.googleapis.com/resources.egressViaIAP"
      ]
    },
    "conditions": {
      "iap.googleapis.com": {
        "expression": "destination.is_registered == true && destination.agent_registry.mcp_server.method != 'tools/call'"
      }
    }
  },
  {
    "description": "Allow Gemini Vertex AI registered endpoint",
    "effect": "ALLOW",
    "principals": [
      "${AGENT_PRINCIPAL}"
    ],
    "operation": {
      "permissions": [
        "iap.googleapis.com/resources.egressViaIAP"
      ]
    },
    "conditions": {
      "iap.googleapis.com": {
        "expression": "destination.is_registered == true && destination.agent_registry.resource_type == 'ENDPOINT'"
      }
    }
  },
  {
    "description": "Allow read_customer_profile",
    "effect": "ALLOW",
    "principals": [
      "${AGENT_PRINCIPAL}"
    ],
    "operation": {
      "permissions": [
        "iap.googleapis.com/resources.egressViaIAP"
      ]
    },
    "conditions": {
      "iap.googleapis.com": {
        "expression": "destination.is_registered == true && destination.agent_registry.mcp_server.method == 'tools/call' && destination.agent_registry.mcp_server.tool.name == 'read_customer_profile'"
      }
    }
  },
  {
    "description": "Deny update_customer_profile",
    "effect": "DENY",
    "principals": [
      "${AGENT_PRINCIPAL}"
    ],
    "operation": {
      "permissions": [
        "iap.googleapis.com/resources.egressViaIAP"
      ]
    },
    "conditions": {
      "iap.googleapis.com": {
        "expression": "destination.is_registered == true && destination.agent_registry.mcp_server.method == 'tools/call' && destination.agent_registry.mcp_server.tool.name == 'update_customer_profile'"
      }
    }
  }
]
